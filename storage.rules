rules_version = '2';

// Regras do Firebase Storage — imagens publicas para leitura, gravacao so
// autenticada (painel). NUNCA voltar para `allow read, write: if true`.
service firebase.storage {
  match /b/{bucket}/o {
    match /imagens/{file=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /{allPaths=**} {
      allow read, write: if request.auth != null;
    }
  }
}
